# GEMINI_API_KEY: required for live Gemini features (AI Stylist, lời bình, caption, đọc ảnh, tạo ảnh).
# AI Studio injects it automatically from the Secrets panel. Without it Vstyle runs in deterministic fallback mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (defaults shown). The server retries once on the fallback model if the primary one is unavailable.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-flash-latest"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
GEMINI_IMAGE_FALLBACK_MODEL="gemini-3.1-flash-lite-image"

# low | medium | high | off  (off = do not send a thinking level, for models without thinking)
GEMINI_THINKING_LEVEL="low"

# Global cap on AI image renders per hour across all visitors (protects the owner's quota when the app is shared).
VSTYLE_RENDER_HOURLY_CAP="120"

# APP_URL: The URL where this applet is hosted. AI Studio injects it with the Cloud Run service URL.
APP_URL="MY_APP_URL"
